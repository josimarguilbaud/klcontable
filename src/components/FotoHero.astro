---
/**
 * La foto de un hero oscuro: a la derecha en escritorio y debajo del texto en
 * móvil, más apaisada para no empujar demasiado lo que sigue.
 *
 * `width`/`height` explícitos para que el navegador reserve el hueco (sin CLS).
 */
import type { Foto } from '../data/imagenes';

interface Props {
  foto: Foto;
}
const { foto } = Astro.props;
---

<img
  src={foto.src}
  srcset={foto.srcset}
  sizes="(min-width: 1024px) 560px, 100vw"
  alt={foto.alt}
  width="1600"
  height="1067"
  loading="eager"
  fetchpriority="high"
  decoding="async"
  class="aspect-[16/9] w-full rounded-2xl object-cover shadow-2xl ring-1 ring-white/10 lg:aspect-[3/2]"
/>
