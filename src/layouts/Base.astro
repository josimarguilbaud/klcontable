---
/**
 * Plantilla base. Aquí vive TODO el SEO estructural, para que ninguna página
 * pueda salir sin canonical, sin descripción o sin datos estructurados: si eso
 * depende de que cada página se acuerde, tarde o temprano una se olvida.
 */
import '../styles/global.css';
import { SITE, OFICIALES } from '../data/site';
import type { Faq } from '../data/servicios';
import { TODOS } from '../data/servicios';
import { GUIAS } from '../data/guias';

interface Props {
  /** Paginas que no deben indexarse (404, gracias, etc.). */
  noindex?: boolean;
  title: string;
  description: string;
  ruta: string;
  /** Migas: [{nombre, ruta}]. La página actual NO se incluye, se añade sola. */
  migas?: { nombre: string; ruta: string }[];
  /** Si la página tiene FAQ visible, se declara aquí para salir en Google. */
  faqs?: Faq[];
}

const { title, description, ruta, migas = [], faqs = [], noindex = false } = Astro.props;
const canonical = new URL(ruta, SITE.dominio).href;

// El negocio, descrito una sola vez. Las claves que no se saben NO se inventan:
// un schema con un dato falso es peor que un schema incompleto.
const negocio: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  '@id': SITE.dominio + '#negocio',
  name: SITE.nombre,
  url: SITE.dominio,
  email: SITE.correo,
  telephone: SITE.telefonoE164,
  priceRange: '$$',
  areaServed: { '@type': 'Country', name: 'Panamá' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.ciudad,
    addressCountry: SITE.pais,
    ...(SITE.direccion ? { streetAddress: SITE.direccion } : {}),
  },
  description:
    'Firma de servicios de contabilidad en Panamá: contabilidad, impuestos ante la DGI, planilla y trámites empresariales.',
};

const migasSchema = migas.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [...migas, { nombre: title.split('|')[0].trim(), ruta }].map((m, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: m.nombre,
        item: new URL(m.ruta, SITE.dominio).href,
      })),
    }
  : null;

const faqSchema = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.p,
        acceptedAnswer: { '@type': 'Answer', text: f.r },
      })),
    }
  : null;

const waTexto = encodeURIComponent('Hola, quisiera información sobre sus servicios contables.');
const waUrl = `https://wa.me/${SITE.whatsapp}?text=${waTexto}`;

/**
 * El menu, con desplegables.
 *
 * Antes «Servicios» era un enlace suelto: los diez servicios y las tres guias
 * solo se veian entrando a una pagina intermedia. Un visitante que buscaba
 * «planilla» no tenia forma de saber desde la cabecera que existia.
 *
 * Se abre al pasar el raton Y al tabular (`focus-within`), asi que funciona con
 * teclado sin una linea de JavaScript. En movil no hay desplegable: se listan
 * los hijos indentados, porque un menu que se despliega dentro de otro menu en
 * una pantalla de 375px es una trampa para el pulgar.
 */
const NAV = [
  { nombre: 'Servicios', ruta: '/services/', hijos: TODOS.map((s) => ({ nombre: s.nombre, ruta: `/services/${s.slug}/` })) },
  { nombre: 'Guías', ruta: '/para-pymes/', hijos: GUIAS.map((g) => ({ nombre: g.nombre, ruta: `/${g.slug}/` })) },
  { nombre: 'Calculadora', ruta: '/calculadoras/', hijos: [] },
  { nombre: 'Nosotros', ruta: '/nosotros/', hijos: [] },
  { nombre: 'Blog', ruta: '/blog/', hijos: [] },
];
---

<!doctype html>
<html lang="es-PA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"}
    />
    <meta name="geo.region" content="PA-8" />
    <meta name="geo.placename" content={SITE.ciudad} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_PA" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800;900&family=Source+Sans+3:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(negocio)} />
    {migasSchema && <script type="application/ld+json" set:html={JSON.stringify(migasSchema)} />}
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

    <!-- Schema propio de la pagina (p.ej. Article en el blog). Va aqui y no en
         el cuerpo: un ld+json dentro de <body> es valido pero se pierde en
         cuanto alguien envuelve el contenido en otro componente. -->
    <slot name="head" />
  </head>

  <body class="bg-white font-sans text-tinta-900 antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-tinta-900 focus:px-4 focus:py-2 focus:text-white"
      >Saltar al contenido</a
    >

    <!-- Barra superior: el teléfono siempre visible. En Panamá la conversión
         real es una llamada o un WhatsApp, no un formulario. -->
    <div class="hidden bg-tinta-900 py-2 text-xs text-tinta-200 md:block">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5">
        <span>{SITE.ciudad} · {SITE.horario}</span>
        <div class="flex gap-5">
          <a href={`mailto:${SITE.correo}`} class="hover:text-acento-400">{SITE.correo}</a>
          <a href={`tel:${SITE.telefonoE164}`} class="font-bold hover:text-acento-400"
            >{SITE.telefono}</a
          >
        </div>
      </div>
    </div>

    <header class="sticky top-0 z-40 border-b border-tinta-200 bg-white/95 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3.5">
        <a href="/" class="flex items-center gap-2.5">
          <span
            class="flex h-10 w-10 items-center justify-center rounded-lg bg-marca-700 font-titulo text-lg font-black text-white"
            >KL</span
          >
          <span class="flex flex-col leading-none">
            <span class="font-titulo text-2xl font-black tracking-tight">KL Contable</span>
            <span class="mt-1 text-[10px] font-semibold tracking-widest text-tinta-500 uppercase"
              >Contador en Panamá</span
            >
          </span>
        </a>

        <nav class="hidden items-center gap-7 md:flex" aria-label="Principal">
          {
            NAV.map((n) =>
              n.hijos.length === 0 ? (
                <a href={n.ruta} class="text-sm font-semibold text-tinta-700 hover:text-marca-700">
                  {n.nombre}
                </a>
              ) : (
                <div class="group relative">
                  <a
                    href={n.ruta}
                    class="flex items-center gap-1 py-3 text-sm font-semibold text-tinta-700 group-hover:text-marca-700 group-focus-within:text-marca-700"
                  >
                    {n.nombre}
                    <svg class="h-3.5 w-3.5 transition group-hover:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
                    </svg>
                  </a>
                  <div class="invisible absolute top-full left-0 z-20 w-72 translate-y-1 rounded-xl border border-tinta-200 bg-white p-2 opacity-0 shadow-[var(--shadow-suave)] transition group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                    {n.hijos.map((h) => (
                      <a href={h.ruta} class="block rounded-lg px-3 py-2.5 text-sm font-semibold text-tinta-700 hover:bg-tinta-50 hover:text-marca-700">
                        {h.nombre}
                      </a>
                    ))}
                    <a href={n.ruta} class="mt-1 block border-t border-tinta-200 px-3 pt-2.5 pb-1 text-sm font-bold text-marca-700">
                      Ver todos →
                    </a>
                  </div>
                </div>
              )
            )
          }
          <a
            href="/contacto/"
            class="rounded-md bg-acento-500 px-5 py-2.5 font-titulo text-sm font-bold text-white shadow-[var(--shadow-acento)] hover:bg-acento-400"
            >Consulta gratuita</a
          >
        </nav>

        <button
          id="boton-menu"
          type="button"
          class="rounded-md p-2 md:hidden"
          aria-controls="menu-movil"
          aria-expanded="false"
          aria-label="Abrir menú"
        >
          <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
            ><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" /></svg
          >
        </button>
      </div>

      <div
        id="menu-movil"
        class="hidden max-h-[calc(100vh-4.75rem)] overflow-y-auto overscroll-contain border-t border-tinta-200 bg-white md:hidden"
      >
        <div class="space-y-1 px-4 py-3">
          {
            NAV.map((n) => (
              n.hijos.length === 0 ? (
                <a href={n.ruta} class="block rounded-md px-3 py-3 font-semibold hover:bg-tinta-50">
                  {n.nombre}
                </a>
              ) : (
                /* Plegado por defecto: con los 13 hijos abiertos el menu medía
                   el doble que la pantalla y empujaba la pagina. <details> lo
                   resuelve de forma nativa, sin JavaScript y accesible. */
                <details class="group/sub">
                  <summary class="flex cursor-pointer list-none items-center justify-between rounded-md px-3 py-3 font-semibold hover:bg-tinta-50">
                    {n.nombre}
                    <svg class="h-4 w-4 text-tinta-500 transition group-open/sub:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
                    </svg>
                  </summary>
                  <div class="mb-1 ml-3 border-l border-tinta-200 pl-3">
                    {n.hijos.map((h) => (
                      <a href={h.ruta} class="block rounded-md px-3 py-2 text-sm text-tinta-700 hover:bg-tinta-50">
                        {h.nombre}
                      </a>
                    ))}
                    <a href={n.ruta} class="block rounded-md px-3 py-2 text-sm font-bold text-marca-700">
                      Ver todos →
                    </a>
                  </div>
                </details>
              )
            ))
          }
          <a
            href="/contacto/"
            class="mt-2 block rounded-md bg-acento-500 px-3 py-3 text-center font-titulo font-bold text-white"
            >Consulta gratuita</a
          >
          <a
            href={`tel:${SITE.telefonoE164}`}
            class="mt-2 block rounded-md border border-tinta-200 px-3 py-3 text-center font-semibold"
            >Llamar al {SITE.telefono}</a
          >
        </div>
      </div>
    </header>

    {
      migas.length > 0 && (
        <nav aria-label="Migas de pan" class="border-b border-tinta-200 bg-tinta-50">
          <ol class="mx-auto flex max-w-6xl flex-wrap gap-2 px-5 py-2.5 text-xs text-tinta-500">
            {migas.map((m) => (
              <li>
                <a href={m.ruta} class="hover:text-marca-700">
                  {m.nombre}
                </a>
                <span class="mx-1.5 text-tinta-200">/</span>
              </li>
            ))}
            <li class="font-semibold text-tinta-700">{title.split('|')[0].trim()}</li>
          </ol>
        </nav>
      )
    }

    <main id="contenido"><slot /></main>

    <footer class="border-t-4 border-acento-500 bg-tinta-900 pt-14 pb-8 text-tinta-200">
      <div class="mx-auto max-w-6xl px-5">
        <div class="grid gap-10 md:grid-cols-3 lg:grid-cols-5">
          <div>
            <p class="font-titulo text-xl font-black text-white">
              KL <span class="text-acento-500">Contable</span>
            </p>
            <p class="mt-3 text-sm leading-relaxed text-tinta-500">
              Servicios de contabilidad, impuestos y planilla para empresas en Panamá.
            </p>
          </div>

          <div>
            <h2 class="mb-4 font-titulo font-bold text-white">Servicios</h2>
            <ul class="space-y-2 text-sm">
              <li><a href="/services/asesoria-contable-panama/" class="hover:text-acento-400">Asesoría contable</a></li>
              <li><a href="/services/servicios-de-contabilidad-outsourcing-en-panama/" class="hover:text-acento-400">Contabilidad outsourcing</a></li>
              <li><a href="/services/servicios-de-gestion-tributaria-en-panama/" class="hover:text-acento-400">Gestión tributaria</a></li>
              <li><a href="/services/servicios-de-planilla-en-panama/" class="hover:text-acento-400">Planilla y CSS</a></li>
            </ul>
          </div>

          <div>
            <h2 class="mb-4 font-titulo font-bold text-white">Guías</h2>
            <ul class="space-y-2 text-sm">
              <li><a href="/para-emprendedores/" class="hover:text-acento-400">Para emprendedores</a></li>
              <li><a href="/para-pymes/" class="hover:text-acento-400">Para pymes</a></li>
              <li><a href="/para-extranjeros/" class="hover:text-acento-400">Para extranjeros</a></li>
              <li><a href="/blog/" class="hover:text-acento-400">Blog</a></li>
              <li><a href="/calculadoras/" class="hover:text-acento-400">Calculadora de Seguro Social</a></li>
            </ul>
          </div>

          <div>
            <h2 class="mb-4 font-titulo font-bold text-white">Enlaces oficiales</h2>
            <ul class="space-y-2 text-sm">
              {
                OFICIALES.map((o) => (
                  <li>
                    <a href={o.url} rel="noopener nofollow" target="_blank" class="hover:text-acento-400">
                      {o.nombre}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h2 class="mb-4 font-titulo font-bold text-white">Contacto</h2>
            <ul class="space-y-2 text-sm">
              <li><a href={`tel:${SITE.telefonoE164}`} class="hover:text-acento-400">{SITE.telefono}</a></li>
              <li><a href={`mailto:${SITE.correo}`} class="break-all hover:text-acento-400">{SITE.correo}</a></li>
              <li>{SITE.ciudad}</li>
              <li>{SITE.horario}</li>
              {SITE.direccion && <li>{SITE.direccion}</li>}
              {SITE.ruc && <li>RUC {SITE.ruc}</li>}
            </ul>
          </div>
        </div>

        <div
          class="mt-12 flex flex-col gap-2 border-t border-tinta-700 pt-6 text-xs text-tinta-500 sm:flex-row sm:items-center sm:justify-between"
        >
          <p>© {new Date().getFullYear()} {SITE.nombre}. {SITE.ciudad}, Panamá.</p>
          {/* `rel="noopener"` no es decorativo: sin el, la pagina destino puede
              manipular esta a traves de `window.opener`. */}
          <p>
            Desarrollado por{' '}
            <a
              href="https://elementoweb.com"
              target="_blank"
              rel="noopener"
              class="font-semibold text-tinta-400 underline underline-offset-2 hover:text-acento-400"
            >
              elementoweb.com
            </a>
          </p>
        </div>
      </div>
    </footer>

    <a
      href={waUrl}
      rel="noopener"
      target="_blank"
      aria-label="Escribir por WhatsApp"
      class="fixed right-5 bottom-5 z-40 flex h-14 w-14 items-center justify-center rounded-full text-white shadow-lg transition-transform hover:scale-105"
      style="background-color: var(--color-whatsapp)"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" class="h-7 w-7" aria-hidden="true">
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 016.988 2.896 9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
        ></path>
      </svg>
    </a>

    <script>
      const b = document.getElementById('boton-menu');
      const m = document.getElementById('menu-movil');
      b?.addEventListener('click', () => {
        const abierto = m?.classList.toggle('hidden') === false;
        b.setAttribute('aria-expanded', String(abierto));
        b.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
      });
    </script>
  </body>
</html>
