    </a>

    <script>
      const b = document.getElementById('boton-menu');
      const m = document.getElementById('menu-movil');
      b?.addEventListener('click', () => {
        const abierto = m?.classList.toggle('hidden') === false;
        b.setAttribute('aria-expanded', String(abierto));
        b.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
      });
    </script>
  </body>
