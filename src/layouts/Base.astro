                ))
              }
            </ul>
          </div>
        </div>

        <div
          class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-tinta-300 sm:flex-row sm:items-center sm:justify-between"
        >
          <p>© {new Date().getFullYear()} {SITE.nombre}. {SITE.ciudad}, Panamá.</p>
          <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
            <a href="/sitemap-index.xml" class="hover:text-acento-400">Mapa del sitio</a>
            {/* `rel="noopener"` no es decorativo: sin él, la página destino puede
                manipular esta a través de `window.opener`. El `nofollow` evita
                que el crédito de agencia cuente como enlace de pie repetido. */}
            <p>
              Desarrollado por{' '}
              <a
                href="https://elementoweb.com"
                target="_blank"
                rel="nofollow noopener"
                class="font-semibold text-tinta-200 underline underline-offset-2 hover:text-acento-400"
              >
                elementoweb.com
              </a>
            </p>
          </div>
        </div>
      </div>
