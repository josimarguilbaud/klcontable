---
/**
 * Plantilla base. Aquí vive TODO el SEO estructural, para que ninguna página
 * pueda salir sin canonical, sin descripción o sin datos estructurados: si eso
 * depende de que cada página se acuerde, tarde o temprano una se olvida.
 */
import '../styles/global.css';
import { SITE, OFICIALES, CONTADORA, CREDENCIAL } from '../data/site';
import type { Faq } from '../data/servicios';
import { TODOS } from '../data/servicios';
import { GUIAS } from '../data/guias';
import { IMG_COMPARTIR } from '../data/imagenes';

interface Props {
  /** Paginas que no deben indexarse (404, gracias, etc.). */
  noindex?: boolean;
  title: string;
  description: string;
  ruta: string;
  /** Migas: [{nombre, ruta}]. La página actual NO se incluye, se añade sola. */
  migas?: { nombre: string; ruta: string }[];
  /** Si la página tiene FAQ visible, se declara aquí para salir en Google. */
  faqs?: Faq[];
  /** Imagen al compartir el enlace (WhatsApp, redes). Si no hay, la genérica. */
  imagen?: string;
}

const { title, description, ruta, migas = [], faqs = [], noindex = false, imagen } = Astro.props;
const ogImagen = new URL(imagen ?? IMG_COMPARTIR, SITE.dominio).href;
const canonical = new URL(ruta, SITE.dominio).href;

// El negocio, descrito una sola vez. Las claves que no se saben NO se inventan:
// un schema con un dato falso es peor que un schema incompleto.
const negocio: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  '@id': SITE.dominio + '/#negocio',
  name: SITE.nombre,
  url: SITE.dominio,
  email: SITE.correo,
  telephone: SITE.telefonoE164,
  priceRange: '$$',
  areaServed: { '@type': 'Country', name: 'Panamá' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.ciudad,
    addressCountry: SITE.pais,
    ...(SITE.direccion ? { streetAddress: SITE.direccion } : {}),
  },
  description: `Firma de Contador Público Autorizado en Panamá, dirigida por la ${CONTADORA.nombreCompleto} (${CREDENCIAL}): contabilidad, impuestos ante la DGI, planilla y trámites empresariales.`,
  // La fundadora y su credencial, en todas las páginas: es la señal de
  // experiencia y autoridad (E-E-A-T) que más pesa en una firma contable.
  founder: {
    '@type': 'Person',
    '@id': SITE.dominio + '/nosotros/#contadora',
    name: CONTADORA.nombre,
    honorificPrefix: CONTADORA.tratamiento,
    jobTitle: CONTADORA.cargo,
    url: `${SITE.dominio}/nosotros/`,
    hasCredential: {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'Idoneidad de Contador Público Autorizado (CPA)',
      identifier: CONTADORA.idoneidadCPA,
      recognizedBy: { '@type': 'Organization', name: 'Junta Técnica de Contabilidad de Panamá' },
    },
  },
  logo: new URL('/img/logo-klcontable.png', SITE.dominio).href,
  image: new URL(IMG_COMPARTIR, SITE.dominio).href,
  // Solo los días: la hora de apertura no está confirmada y no se inventa.
  openingHours: 'Mo-Fr',
  inLanguage: 'es-PA',
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: SITE.telefonoE164,
    email: SITE.correo,
    contactType: 'customer service',
    areaServed: 'PA',
    availableLanguage: 'es',
  },
  knowsAbout: ['Contabilidad', 'Impuestos en Panamá', 'ITBMS', 'Planilla y CSS', 'Auditoría', 'Facturación electrónica'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de contabilidad en Panamá',
    itemListElement: TODOS.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.nombre, url: `${SITE.dominio}/servicios/${s.slug}/` },
    })),
  },
};

/** El sitio como tal: le dice a Google el nombre de marca que debe mostrar. */
const sitio = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': SITE.dominio + '/#sitio',
  name: SITE.nombre,
  url: SITE.dominio + '/',
  inLanguage: 'es-PA',
  publisher: { '@id': SITE.dominio + '/#negocio' },
};

const migasSchema = migas.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [...migas, { nombre: title.split('|')[0].trim(), ruta }].map((m, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: m.nombre,
        item: new URL(m.ruta, SITE.dominio).href,
      })),
    }
  : null;

const faqSchema = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.p,
        acceptedAnswer: { '@type': 'Answer', text: f.r },
      })),
    }
  : null;

const waTexto = encodeURIComponent('Hola, quisiera información sobre sus servicios contables.');
const waUrl = `https://wa.me/${SITE.whatsapp}?text=${waTexto}`;

/**
 * El menu, con desplegables.
 *
 * Antes «Servicios» era un enlace suelto: los diez servicios y las tres guias
 * solo se veian entrando a una pagina intermedia. Un visitante que buscaba
 * «planilla» no tenia forma de saber desde la cabecera que existia.
 *
 * Se abre al pasar el raton Y al tabular (`focus-within`), asi que funciona con
 * teclado sin una linea de JavaScript. En movil no hay desplegable: se listan
 * los hijos indentados, porque un menu que se despliega dentro de otro menu en
 * una pantalla de 375px es una trampa para el pulgar.
 */
const NAV = [
  { nombre: 'Servicios', ruta: '/servicios/', hijos: TODOS.map((s) => ({ nombre: s.nombre, ruta: `/servicios/${s.slug}/` })) },
  { nombre: 'Guías', ruta: '/para-pymes/', hijos: GUIAS.map((g) => ({ nombre: g.nombre, ruta: `/${g.slug}/` })) },
  { nombre: 'Calculadora', ruta: '/calculadoras/', hijos: [] },
  { nombre: 'Nosotros', ruta: '/nosotros/', hijos: [] },
  { nombre: 'Blog', ruta: '/blog/', hijos: [] },
];
---

<!doctype html>
<html lang="es-PA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#001830" />
    <!-- Favicon: el isotipo del logo. `.ico` en la raíz porque navegadores y
         lectores de feeds lo piden ahí sin leer el HTML; el PNG de 48 px es
         el que Google usa junto al resultado de búsqueda (múltiplo de 48). -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"}
    />
    <meta name="geo.region" content="PA-8" />
    <meta name="geo.placename" content={SITE.ciudad} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_PA" />
    <meta property="og:image" content={ogImagen} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImagen} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800;900&family=Source+Sans+3:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(negocio)} />
    {ruta === '/' && <script type="application/ld+json" set:html={JSON.stringify(sitio)} />}
    {migasSchema && <script type="application/ld+json" set:html={JSON.stringify(migasSchema)} />}
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

    <!-- Schema propio de la pagina (p.ej. Article en el blog). Va aqui y no en
         el cuerpo: un ld+json dentro de <body> es valido pero se pierde en
         cuanto alguien envuelve el contenido en otro componente. -->
    <slot name="head" />
  </head>

  <body class="bg-white font-sans text-tinta-900 antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-tinta-900 focus:px-4 focus:py-2 focus:text-white"
      >Saltar al contenido</a
    >

    <!-- Barra superior: el teléfono siempre visible. En Panamá la conversión
         real es una llamada o un WhatsApp, no un formulario. -->
    <div class="hidden bg-tinta-900 py-2 text-xs text-tinta-200 md:block">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5">
        <span>Contador Público Autorizado · {CREDENCIAL} · {SITE.ciudad}</span>
        <div class="flex gap-5">
          <a href={`mailto:${SITE.correo}`} class="hover:text-acento-400">{SITE.correo}</a>
          <a href={`tel:${SITE.telefonoE164}`} class="font-bold hover:text-acento-400"
            >{SITE.telefono}</a
          >
        </div>
      </div>
    </div>

    <header class="sticky top-0 z-40 border-b border-tinta-200 bg-white/95 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3.5">
        {/* El logo real de la marca, rescatado del WordPress caido via
            web.archive.org. Antes habia aqui un cuadradito «KL» de relleno.
            `width`/`height` explicitos para que el navegador reserve el hueco
            y la cabecera no de un salto al cargar (evita CLS). */}
        <a href="/" class="flex items-center" aria-label="KL Contable, inicio">
          <img
            src="/img/logo-klcontable.png"
            alt="KL Contable"
            width="600"
            height="125"
            class="h-11 w-auto sm:h-12"
            fetchpriority="high"
          />
        </a>

        <nav class="hidden items-center gap-7 md:flex" aria-label="Principal">
          {
            NAV.map((n) =>
              n.hijos.length === 0 ? (
                <a href={n.ruta} class="text-sm font-semibold text-tinta-700 hover:text-marca-700">
                  {n.nombre}
                </a>
              ) : (
                <div class="group relative">
                  <a
                    href={n.ruta}
                    class="flex items-center gap-1 py-3 text-sm font-semibold text-tinta-700 group-hover:text-marca-700 group-focus-within:text-marca-700"
                  >
                    {n.nombre}
                    <svg class="h-3.5 w-3.5 transition group-hover:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
                    </svg>
                  </a>
                  <div class="invisible absolute top-full left-0 z-20 w-72 translate-y-1 rounded-xl border border-tinta-200 bg-white p-2 opacity-0 shadow-[var(--shadow-suave)] transition group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                    {n.hijos.map((h) => (
                      <a href={h.ruta} class="block rounded-lg px-3 py-2.5 text-sm font-semibold text-tinta-700 hover:bg-tinta-50 hover:text-marca-700">
                        {h.nombre}
                      </a>
                    ))}
                    <a href={n.ruta} class="mt-1 block border-t border-tinta-200 px-3 pt-2.5 pb-1 text-sm font-bold text-marca-700">
                      Ver todos →
                    </a>
                  </div>
                </div>
              )
            )
          }
          <a
            href="/contacto/"
            class="rounded-md bg-acento-500 px-5 py-2.5 font-titulo text-sm font-bold text-white shadow-[var(--shadow-acento)] hover:bg-marca-800"
            >Consulta gratuita</a
          >
        </nav>

        <button
          id="boton-menu"
          type="button"
          class="rounded-md p-2 md:hidden"
          aria-controls="menu-movil"
          aria-expanded="false"
          aria-label="Abrir menú"
        >
          <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
            ><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" /></svg
          >
        </button>
      </div>

      <div
        id="menu-movil"
        class="hidden max-h-[calc(100vh-4.75rem)] overflow-y-auto overscroll-contain border-t border-tinta-200 bg-white md:hidden"
      >
        <div class="space-y-1 px-4 py-3">
          {
            NAV.map((n) => (
              n.hijos.length === 0 ? (
                <a href={n.ruta} class="block rounded-md px-3 py-3 font-semibold hover:bg-tinta-50">
                  {n.nombre}
                </a>
              ) : (
                /* Plegado por defecto: con los 13 hijos abiertos el menu medía
                   el doble que la pantalla y empujaba la pagina. <details> lo
                   resuelve de forma nativa, sin JavaScript y accesible. */
                <details class="group/sub">
                  <summary class="flex cursor-pointer list-none items-center justify-between rounded-md px-3 py-3 font-semibold hover:bg-tinta-50">
                    {n.nombre}
                    <svg class="h-4 w-4 text-tinta-500 transition group-open/sub:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
                    </svg>
                  </summary>
                  <div class="mb-1 ml-3 border-l border-tinta-200 pl-3">
                    {n.hijos.map((h) => (
                      <a href={h.ruta} class="block rounded-md px-3 py-2 text-sm text-tinta-700 hover:bg-tinta-50">
                        {h.nombre}
                      </a>
                    ))}
                    <a href={n.ruta} class="block rounded-md px-3 py-2 text-sm font-bold text-marca-700">
                      Ver todos →
                    </a>
                  </div>
                </details>
              )
            ))
          }
          <a
            href="/contacto/"
            class="mt-2 block rounded-md bg-acento-500 px-3 py-3 text-center font-titulo font-bold text-white"
            >Consulta gratuita</a
          >
          <a
            href={`tel:${SITE.telefonoE164}`}
            class="mt-2 block rounded-md border border-tinta-200 px-3 py-3 text-center font-semibold"
            >Llamar al {SITE.telefono}</a
          >
        </div>
      </div>
    </header>

    {
      migas.length > 0 && (
        <nav aria-label="Migas de pan" class="border-b border-tinta-200 bg-tinta-50">
          <ol class="mx-auto flex max-w-6xl flex-wrap gap-2 px-5 py-2.5 text-xs text-tinta-500">
            {migas.map((m) => (
              <li>
                <a href={m.ruta} class="hover:text-marca-700">
                  {m.nombre}
                </a>
                <span class="mx-1.5 text-tinta-200">/</span>
              </li>
            ))}
            <li class="font-semibold text-tinta-700">{title.split('|')[0].trim()}</li>
          </ol>
        </nav>
      )
    }

    <main id="contenido"><slot /></main>

    <footer class="border-t-4 border-acento-500 bg-tinta-900 text-tinta-200">
      <div class="mx-auto max-w-6xl px-5 pt-14 pb-8">
        <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-12">
          <!-- Marca y contacto -->
          <div class="lg:col-span-4">
            <a href="/" aria-label="KL Contable, inicio" class="inline-block">
              <img
                src="/img/logo-klcontable-blanco.png"
                alt="KL Contable"
                width="600"
                height="125"
                loading="lazy"
                decoding="async"
                class="h-12 w-auto"
              />
            </a>
            <p class="mt-4 max-w-xs text-sm leading-relaxed text-tinta-300">
              Servicios de contabilidad, impuestos y planilla para empresas y
              emprendedores en Panamá{SITE.anosExperiencia ? `, con ${SITE.anosExperiencia} años de experiencia` : ''}.
            </p>
            <a href="/nosotros/" class="mt-4 inline-flex items-center gap-2 rounded-lg border border-white/15 px-3 py-2 text-xs text-tinta-200 hover:border-acento-400">
              <svg class="h-4 w-4 shrink-0 text-acento-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
              <span><strong class="text-white">{CONTADORA.nombreCompleto}</strong> · Contadora Pública Autorizada · {CREDENCIAL}</span>
            </a>

            <ul class="mt-6 space-y-3 text-sm">
              <li>
                <a href={`tel:${SITE.telefonoE164}`} class="flex items-center gap-3 hover:text-acento-400">
                  <svg class="h-5 w-5 shrink-0 text-acento-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.28 6.72 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.37c0-.52-.35-.97-.85-1.09l-4.42-1.1a1.12 1.12 0 0 0-1.17.42l-.97 1.29a1.12 1.12 0 0 1-1.21.38 12.04 12.04 0 0 1-7.14-7.14 1.12 1.12 0 0 1 .38-1.21l1.29-.97c.36-.27.52-.73.42-1.17l-1.1-4.42a1.12 1.12 0 0 0-1.09-.85H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
                  {SITE.telefono}
                </a>
              </li>
              <li>
                <a href={waUrl} rel="noopener" target="_blank" class="flex items-center gap-3 hover:text-acento-400">
                  <svg class="h-5 w-5 shrink-0 text-acento-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM2.25 12.76c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 0 1 .778-.332 48.3 48.3 0 0 0 5.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.4 48.4 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" /></svg>
                  WhatsApp
                </a>
              </li>
              <li>
                <a href={`mailto:${SITE.correo}`} class="flex items-center gap-3 break-all hover:text-acento-400">
                  <svg class="h-5 w-5 shrink-0 text-acento-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.24a2.25 2.25 0 0 1-1.07 1.92l-7.5 4.62a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.92V6.75" /></svg>
                  {SITE.correo}
                </a>
              </li>
              <li class="flex items-center gap-3">
                <svg class="h-5 w-5 shrink-0 text-acento-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
                {SITE.direccion ?? `${SITE.ciudad}, Panamá`}
              </li>
              <li class="flex items-center gap-3">
                <svg class="h-5 w-5 shrink-0 text-acento-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                {SITE.horario}
              </li>
              {SITE.ruc && <li class="pl-8 text-tinta-300">RUC {SITE.ruc}</li>}
            </ul>
          </div>

          <!-- Los diez servicios, no cuatro: cada enlace del pie es un enlace
               interno en TODAS las páginas del sitio. -->
          <div class="lg:col-span-3">
            <h2 class="mb-4 font-titulo font-bold text-white">Servicios</h2>
            <ul class="grid grid-cols-2 gap-x-6 gap-y-2.5 text-sm md:grid-cols-1">
              {
                TODOS.map((s) => (
                  <li>
                    <a href={`/servicios/${s.slug}/`} class="hover:text-acento-400">
                      {s.nombre}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="lg:col-span-2">
            <h2 class="mb-4 font-titulo font-bold text-white">Guías y recursos</h2>
            <ul class="grid grid-cols-2 gap-x-6 gap-y-2.5 text-sm md:grid-cols-1">
              {
                GUIAS.map((g) => (
                  <li>
                    <a href={`/${g.slug}/`} class="hover:text-acento-400">
                      {g.nombre}
                    </a>
                  </li>
                ))
              }
              <li><a href="/blog/" class="hover:text-acento-400">Blog</a></li>
              <li><a href="/novedades/" class="hover:text-acento-400">Novedades DGI y CSS</a></li>
              <li><a href="/calculadoras/" class="hover:text-acento-400">Calculadora de Seguro Social</a></li>
              <li><a href="/nosotros/" class="hover:text-acento-400">Nosotros</a></li>
