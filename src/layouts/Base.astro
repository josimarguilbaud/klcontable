              {
                OFICIALES.map((o) => (
                  <li>
                    <a href={o.url} rel="noopener nofollow" target="_blank" class="inline-flex items-start gap-1.5 hover:text-acento-400">
                      {o.nombre}
                      <svg class="mt-1 h-3.5 w-3.5 shrink-0 opacity-60" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
                      <span class="sr-only">(se abre en otra pestaña)</span>
                    </a>
