---
/**
 * Índice de servicios. Ruta `/services/` porque es la que Google tiene
 * indexada; el hecho de que esté en inglés es herencia de la web anterior y
 * no se toca.
 *
 * La web vieja tenía aquí «Archivos: Services» como H1, que es el título que
 * pone WordPress por defecto y no significa nada para nadie. Reemplazado por
 * un H1 con la frase que la gente busca.
 */
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site';
import { SERVICIOS } from '../../data/servicios';
---

<Base
  title="Servicios Contables en Panamá | Contabilidad, Impuestos y Planilla — KL Contable"
  description="Servicios contables en Panamá: asesoría, contabilidad outsourcing, auditoría, gestión tributaria ante la DGI, planilla con la CSS y trámites empresariales."
  ruta="/services/"
  migas={[{ nombre: 'Inicio', ruta: '/' }]}
>
  <section class="hero-degradado bg-tinta-900">
    <div class="mx-auto max-w-6xl px-5 py-16 lg:py-20">
      <h1 class="max-w-3xl font-titulo text-3xl leading-[1.08] font-black tracking-tight text-white sm:text-4xl lg:text-5xl">
        Servicios contables en Panamá
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-tinta-200">
        Seis servicios que cubren el ciclo completo de una empresa panameña.
        Puede contratarlos juntos o solo el que necesita.
      </p>
    </div>
  </section>

  <section class="py-16 lg:py-20">
    <div class="mx-auto max-w-6xl px-5">
      <div class="grid gap-6 md:grid-cols-2">
        {
          SERVICIOS.map((s) => (
            <a
              href={`/services/${s.slug}/`}
              class="tarjeta group rounded-xl border border-tinta-200 bg-white p-8"
            >
              <h2 class="font-titulo text-2xl font-bold group-hover:text-marca-700">{s.nombre}</h2>
              <p class="mt-3 text-lg text-tinta-700">{s.gancho}</p>
              <p class="mt-4 text-sm text-tinta-500">{s.paraQuien}</p>
              <span class="mt-5 inline-block font-bold text-marca-700">Ver el servicio →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-tinta-900 py-16">
    <div class="mx-auto max-w-3xl px-5 text-center">
      <h2 class="font-titulo text-2xl font-black tracking-tight text-white lg:text-3xl">
        ¿No sabe cuál necesita?
      </h2>
      <p class="mt-3 text-tinta-200">
        Cuéntenos su caso y le decimos qué hace falta. Si no necesita nada, también se lo decimos.
      </p>
      <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={`tel:${SITE.telefonoE164}`} class="rounded-md bg-acento-500 px-6 py-3.5 font-titulo font-bold text-white hover:bg-acento-400">
          Llamar al {SITE.telefono}
        </a>
        <a href="/contacto/" class="rounded-md border border-white/25 px-6 py-3.5 font-titulo font-bold text-white hover:bg-white/10">
          Escribir un mensaje
        </a>
      </div>
    </div>
  </section>
</Base>
