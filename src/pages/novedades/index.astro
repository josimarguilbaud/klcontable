---
/**
 * Novedades DGI y CSS: los cambios normativos, con fecha y fuente oficial.
 *
 * Se separa del blog a propósito: el blog explica temas que no caducan; esto
 * es lo que cambió y desde cuándo. Cada nota enlaza a su fuente oficial y dice
 * cuándo se comprobó (ver la regla dura en `src/data/novedades.ts`).
 */
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site';
import { NOVEDADES } from '../../data/novedades';
import { fotoIA } from '../../data/imagenes';
import { fechaLarga } from '../../lib/texto';

const notas = [...NOVEDADES]
  .sort((a, b) => b.fecha.localeCompare(a.fecha))
  .map((n) => ({ ...n, foto: fotoIA(`novedad/${n.slug}`) ?? (n.articulos?.[0] ? fotoIA(`blog/${n.articulos[0]}`) : undefined) }));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Novedades DGI y CSS en Panamá',
  url: `${SITE.dominio}/novedades/`,
  inLanguage: 'es-PA',
  publisher: { '@id': SITE.dominio + '/#negocio' },
  hasPart: notas.map((n) => ({
    '@type': 'NewsArticle',
    headline: n.h1,
    url: `${SITE.dominio}/novedades/${n.slug}/`,
    datePublished: n.fecha,
  })),
};
---

<Base
  title="Novedades DGI y CSS en Panamá | KL Contable"
  description="Los cambios de la DGI, la CSS y otras entidades que afectan a su empresa en Panamá, explicados en claro, con su fecha y el enlace a la fuente oficial."
  ruta="/novedades/"
  migas={[{ nombre: 'Inicio', ruta: '/' }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <section class="hero-degradado bg-tinta-900">
    <div class="mx-auto max-w-6xl px-5 py-16 lg:py-20">
      <p class="mb-4 text-xs font-bold tracking-widest text-acento-400 uppercase">Actualidad fiscal y laboral</p>
      <h1 class="max-w-3xl font-titulo text-3xl leading-[1.08] font-black tracking-tight text-white sm:text-4xl lg:text-5xl">
        Novedades DGI y CSS en Panamá
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-tinta-200">
        Lo que cambió, desde cuándo y a quién le afecta. Cada nota enlaza a la
        norma o al comunicado oficial y dice cuándo lo comprobamos.
      </p>
    </div>
  </section>

  <section class="py-16 lg:py-20">
    <div class="mx-auto max-w-6xl px-5">
      <div class="grid gap-6 md:grid-cols-2">
        {
          notas.map((n) => (
            <a href={`/novedades/${n.slug}/`} class="tarjeta group flex flex-col overflow-hidden rounded-xl border border-tinta-200 bg-white">
              {n.foto && (
                <img
                  src={n.foto.src}
                  srcset={n.foto.srcset}
                  sizes="(min-width: 768px) 560px, 100vw"
                  alt=""
                  width="1600"
                  height="900"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[16/9] w-full object-cover"
                />
              )}
              <div class="flex grow flex-col p-7">
                <p class="text-xs font-bold tracking-widest text-marca-700 uppercase">
                  {n.entidad} · <time datetime={n.fecha}>{fechaLarga(n.fecha)}</time>
                </p>
                <h2 class="mt-3 font-titulo text-xl leading-snug font-bold group-hover:text-marca-700">{n.h1}</h2>
                <p class="mt-3 grow leading-relaxed text-tinta-700">{n.resumen}</p>
                <span class="mt-5 inline-block text-sm font-bold text-marca-700">Leer la nota →</span>
              </div>
            </a>
          ))
        }
      </div>

      <div class="mt-12 rounded-2xl border border-tinta-200 bg-tinta-50 p-8 lg:p-10">
        <h2 class="font-titulo text-xl font-black tracking-tight lg:text-2xl">¿Le afecta algún cambio?</h2>
        <p class="mt-3 max-w-2xl leading-relaxed text-tinta-700">
          Si no está seguro de cómo le toca una norma nueva, pregúntenos. Se lo
          decimos con su caso delante, sin costo en la primera consulta.
        </p>
        <a
          href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent('Hola, tengo una duda sobre un cambio de la DGI o la CSS.')}`}
          rel="noopener"
          target="_blank"
          class="mt-6 inline-block rounded-md px-6 py-3.5 font-titulo font-bold text-white transition hover:opacity-90"
          style="background-color: var(--color-whatsapp)"
        >
          Preguntar por WhatsApp
        </a>
      </div>
    </div>
  </section>
</Base>
