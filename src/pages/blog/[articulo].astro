---
/**
 * Un artículo del blog.
 *
 * Cada artículo termina en una llamada al servicio que le corresponde, no en
 * un CTA genérico: quien acaba de leer sobre el costo de un empleado quiere
 * hablar de planilla, no de "servicios contables" en abstracto.
 *
 * El schema `Article` va aquí y no en Base porque solo aplica a estas páginas.
 */
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site';
import { ARTICULOS } from '../../data/articulos';
import { SERVICIOS } from '../../data/servicios';

export function getStaticPaths() {
  return ARTICULOS.map((a) => ({ params: { articulo: a.slug }, props: { a } }));
}

const { a } = Astro.props;
const servicio = a.servicio ? SERVICIOS.find((s) => s.slug === a.servicio) : undefined;

// Los otros artículos, los más recientes primero, sin repetir este.
const otros = [...ARTICULOS]
  .filter((x) => x.slug !== a.slug)
  .sort((x, y) => y.fecha.localeCompare(x.fecha))
  .slice(0, 3);

const fecha = new Date(a.fecha + 'T12:00:00Z').toLocaleDateString('es-PA', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: a.h1,
  description: a.descripcion,
  datePublished: a.fecha,
  dateModified: a.fecha,
  inLanguage: 'es-PA',
  mainEntityOfPage: `${SITE.url}/blog/${a.slug}/`,
  author: { '@type': 'Organization', name: SITE.nombre, url: SITE.url },
  publisher: { '@type': 'Organization', name: SITE.nombre, url: SITE.url },
};
---

<Base
  title={a.titulo}
  description={a.descripcion}
  ruta={`/blog/${a.slug}/`}
  migas={[{ nombre: 'Inicio', ruta: '/' }, { nombre: 'Blog', ruta: '/blog/' }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <article>
    <section class="hero-degradado bg-tinta-900">
      <div class="mx-auto max-w-3xl px-5 py-16 lg:py-20">
        <p class="mb-4 text-xs font-bold tracking-widest text-acento-400 uppercase">
          {fecha} · {a.minutos} min de lectura
        </p>
        <h1 class="font-titulo text-3xl leading-[1.1] font-black tracking-tight text-white sm:text-4xl">
          {a.h1}
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-tinta-200">{a.entradilla}</p>
      </div>
    </section>

    <section class="py-14 lg:py-20">
      <div class="mx-auto max-w-3xl px-5">
        {
          a.secciones.map((s) => (
            <div class="mb-11">
              <h2 class="font-titulo text-2xl leading-snug font-black tracking-tight">{s.t}</h2>
              <div class="mt-4 space-y-4 text-lg leading-relaxed text-tinta-700">
                {s.p.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </div>
          ))
        }

        <!-- El cierre apunta al servicio del que trata el artículo, no a uno genérico -->
        <div class="rounded-2xl border border-tinta-200 bg-tinta-50 p-8 lg:p-10">
          <h2 class="font-titulo text-xl font-black tracking-tight lg:text-2xl">
            ¿Le pasa esto en su empresa?
          </h2>
          <p class="mt-3 leading-relaxed text-tinta-700">
            La primera consulta no cuesta nada y se resuelve por WhatsApp. Si
            resulta que no necesita nada, también se lo decimos.
          </p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a
              href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent('Hola, leí el artículo «' + a.h1 + '» y quisiera una consulta.')}`}
              rel="noopener"
              target="_blank"
              class="rounded-md px-6 py-3.5 text-center font-titulo font-bold text-white transition hover:opacity-90"
              style="background-color: var(--color-whatsapp)"
            >
              Preguntar por WhatsApp
            </a>
            {
              servicio && (
                <a
                  href={`/services/${servicio.slug}/`}
                  class="rounded-md border border-tinta-300 px-6 py-3.5 text-center font-titulo font-bold transition hover:bg-white"
                >
                  Ver {servicio.nombre}
                </a>
              )
            }
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-tinta-200 py-14 lg:py-16">
      <div class="mx-auto max-w-6xl px-5">
        <h2 class="font-titulo text-2xl font-black tracking-tight">Seguir leyendo</h2>
        <div class="mt-7 grid gap-5 md:grid-cols-3">
          {
            otros.map((o) => (
              <a href={`/blog/${o.slug}/`} class="tarjeta rounded-xl border border-tinta-200 bg-white p-6">
                <h3 class="font-titulo text-lg leading-snug font-bold">{o.h1}</h3>
                <p class="mt-2 text-sm text-tinta-700">{o.entradilla}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </article>
</Base>
