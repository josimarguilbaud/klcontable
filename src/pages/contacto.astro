---
/**
 * Contacto.
 *
 * El orden importa: primero WhatsApp y teléfono, después el formulario. En
 * Panamá la conversión real de una pyme es un WhatsApp, no rellenar campos —
 * es la misma decisión que ya se tomó en las webs de San Blas y de movers.
 *
 * El formulario postea al webhook de n8n, igual que PIM y PWE. ⚠️ El workflow
 * `klcontable-lead` HAY QUE CREARLO todavía: hasta entonces el formulario da
 * error y por eso WhatsApp va primero y bien visible.
 */
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
import { TODOS } from '../data/servicios';

const waTexto = encodeURIComponent('Hola, quisiera una consulta sobre servicios contables.');
---

<Base
  title="Contacto | Consulta Contable Gratuita en Panamá — KL Contable"
  description="Hable con un contador en Panamá. Primera consulta gratuita por WhatsApp, teléfono o correo. Le decimos qué necesita y cuánto cuesta, sin compromiso."
  ruta="/contacto/"
  migas={[{ nombre: 'Inicio', ruta: '/' }]}
>
  <section class="hero-degradado bg-tinta-900">
    <div class="mx-auto max-w-6xl px-5 py-16 lg:py-20">
      <h1 class="max-w-3xl font-titulo text-3xl leading-[1.08] font-black tracking-tight text-white sm:text-4xl lg:text-5xl">
        Cuéntenos su caso
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-tinta-200">
        La primera consulta no cuesta nada. Le decimos qué necesita y cuánto
        cuesta. Si resulta que no necesita nada, también se lo decimos.
      </p>
    </div>
  </section>

  <section class="py-16 lg:py-20">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 lg:grid-cols-[.85fr_1.15fr]">
      <!-- Vías directas primero: es lo que la gente usa de verdad -->
      <div>
        <h2 class="font-titulo text-2xl font-black tracking-tight">La vía rápida</h2>
        <p class="mt-3 text-tinta-700">
          Escriba o llame y le contestamos el mismo día. {SITE.horario}.
        </p>

        <div class="mt-7 space-y-3">
          <a
            href={`https://wa.me/${SITE.whatsapp}?text=${waTexto}`}
            rel="noopener"
            target="_blank"
            class="flex items-center justify-center gap-2 rounded-lg px-6 py-4 font-titulo font-bold text-white transition hover:opacity-90"
            style="background-color: var(--color-whatsapp)"
          >
            Escribir por WhatsApp
          </a>
          <a
            href={`tel:${SITE.telefonoE164}`}
            class="flex items-center justify-center rounded-lg bg-marca-700 px-6 py-4 font-titulo font-bold text-white transition hover:bg-marca-600"
          >
            Llamar al {SITE.telefono}
          </a>
          <a
            href={`mailto:${SITE.correo}`}
            class="flex items-center justify-center rounded-lg border border-tinta-200 px-6 py-4 font-titulo font-bold transition hover:bg-tinta-50"
          >
            {SITE.correo}
          </a>
        </div>

        <div class="mt-9 rounded-xl border border-tinta-200 bg-tinta-50 p-6">
          <p class="font-titulo font-bold">¿Qué le vamos a preguntar?</p>
          <ul class="mt-3 space-y-2 text-sm text-tinta-700">
            <li>A qué se dedica su empresa y desde cuándo.</li>
            <li>Si tiene empleados en planilla.</li>
            <li>En qué estado está su contabilidad hoy.</li>
          </ul>
          <p class="mt-4 text-sm text-tinta-500">
            Nada de esto compromete a nada. Sirve para darle un precio real y no
            una cifra al aire.
          </p>
        </div>
      </div>

      <!-- Formulario -->
      <div class="rounded-xl border border-tinta-200 bg-white p-7 shadow-[var(--shadow-suave)] lg:p-9">
        <h2 class="font-titulo text-2xl font-black tracking-tight">O escríbanos aquí</h2>
        <p class="mt-2 text-tinta-700">Le respondemos en menos de 24 horas hábiles.</p>

        <form id="formulario" class="mt-7 space-y-5">
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="nombre" class="mb-1.5 block text-sm font-semibold">Nombre completo *</label>
              <input id="nombre" name="nombre" type="text" required
                class="w-full rounded-lg border border-tinta-200 bg-tinta-50 px-4 py-3 outline-none focus:border-marca-700 focus:ring-2 focus:ring-marca-700/20" />
            </div>
            <div>
              <label for="empresa" class="mb-1.5 block text-sm font-semibold">Empresa</label>
              <input id="empresa" name="empresa" type="text"
                class="w-full rounded-lg border border-tinta-200 bg-tinta-50 px-4 py-3 outline-none focus:border-marca-700 focus:ring-2 focus:ring-marca-700/20" />
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="telefono" class="mb-1.5 block text-sm font-semibold">WhatsApp o teléfono *</label>
              <input id="telefono" name="telefono" type="tel" required placeholder="+507"
                class="w-full rounded-lg border border-tinta-200 bg-tinta-50 px-4 py-3 outline-none focus:border-marca-700 focus:ring-2 focus:ring-marca-700/20" />
            </div>
            <div>
              <label for="correo" class="mb-1.5 block text-sm font-semibold">Correo</label>
              <input id="correo" name="correo" type="email"
                class="w-full rounded-lg border border-tinta-200 bg-tinta-50 px-4 py-3 outline-none focus:border-marca-700 focus:ring-2 focus:ring-marca-700/20" />
            </div>
          </div>

          <div>
            <label for="servicio" class="mb-1.5 block text-sm font-semibold">¿Qué necesita?</label>
            <select id="servicio" name="servicio"
              class="w-full rounded-lg border border-tinta-200 bg-tinta-50 px-4 py-3 outline-none focus:border-marca-700 focus:ring-2 focus:ring-marca-700/20">
              <option value="">No estoy seguro, quiero que me orienten</option>
              {TODOS.map((s) => <option value={s.nombre}>{s.nombre}</option>)}
            </select>
          </div>

          <div>
            <label for="mensaje" class="mb-1.5 block text-sm font-semibold">Cuéntenos brevemente</label>
            <textarea id="mensaje" name="mensaje" rows="4"
              class="w-full resize-none rounded-lg border border-tinta-200 bg-tinta-50 px-4 py-3 outline-none focus:border-marca-700 focus:ring-2 focus:ring-marca-700/20"></textarea>
          </div>

          <!-- Trampa para robots: un humano nunca rellena un campo oculto. -->
          <input type="text" name="botcheck" tabindex="-1" autocomplete="off"
            class="absolute -left-[9999px]" aria-hidden="true" />

          <button type="submit" id="enviar"
            class="w-full rounded-lg bg-acento-500 py-4 font-titulo text-lg font-bold text-white transition hover:bg-acento-400 disabled:opacity-60">
            Solicitar consulta gratuita
          </button>

          <p id="aviso" class="hidden rounded-lg p-4 text-center text-sm font-semibold"></p>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  const f = document.getElementById('formulario') as HTMLFormElement | null;
  const aviso = document.getElementById('aviso');
  const boton = document.getElementById('enviar') as HTMLButtonElement | null;

  f?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!aviso || !boton) return;

    // Si el campo trampa viene lleno, es un robot: se finge éxito y no se manda.
    const datos = new FormData(f);
    if (datos.get('botcheck')) return;

    boton.disabled = true;
    boton.textContent = 'Enviando…';

    try {
      const r = await fetch('https://n8n.aiwebstudio.co/webhook/klcontable-lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(datos as any),
      });
      if (!r.ok) throw new Error(String(r.status));
      aviso.className = 'rounded-lg bg-marca-50 p-4 text-center text-sm font-semibold text-marca-800';
      aviso.textContent = 'Recibido. Le escribimos en menos de 24 horas hábiles.';
      f.reset();
    } catch {
      // Nunca dejar al cliente en un callejón: si el envío falla, se le da la
      // vía que sí funciona en vez de un «error» a secas.
      aviso.className = 'rounded-lg bg-amber-50 p-4 text-center text-sm font-semibold text-amber-900';
      aviso.innerHTML =
        'No se pudo enviar. Escríbanos por <a class="underline" href="https://wa.me/50769317568">WhatsApp</a> o llame al 6931-7568.';
    } finally {
      aviso.classList.remove('hidden');
      boton.disabled = false;
      boton.textContent = 'Solicitar consulta gratuita';
    }
  });
</script>
