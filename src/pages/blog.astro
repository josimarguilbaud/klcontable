---
/**
 * Blog. Ruta `/blog/`, la que estaba indexada en la web anterior.
 *
 * Del sitio viejo solo sobrevivió el índice: el archivo nunca capturó los
 * artículos. Ahora la ruta tiene contenido propio en vez de existir solo para
 * no devolver un 404.
 *
 * Los artículos se ordenan por fecha aquí, explícitamente. `ARTICULOS` es un
 * array a mano y hoy ya está ordenado, pero confiar en eso es la clase de cosa
 * que se rompe en silencio cuando alguien añade uno en medio.
 */
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
import { ARTICULOS } from '../data/articulos';

const posts = [...ARTICULOS].sort((a, b) => b.fecha.localeCompare(a.fecha));
const [destacado, ...resto] = posts;

const fmt = (iso: string) =>
  new Date(iso + 'T12:00:00Z').toLocaleDateString('es-PA', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
---

<Base
  title="Blog Contable y Fiscal en Panamá | KL Contable"
  description="Artículos sobre contabilidad, impuestos y planilla en Panamá, explicados en palabras claras para dueños de empresa. Sin jerga y sin letra pequeña."
  ruta="/blog/"
  migas={[{ nombre: 'Inicio', ruta: '/' }]}
>
  <section class="hero-degradado bg-tinta-900">
    <div class="mx-auto max-w-6xl px-5 py-16 lg:py-20">
      <h1 class="max-w-3xl font-titulo text-3xl leading-[1.08] font-black tracking-tight text-white sm:text-4xl lg:text-5xl">
        Contabilidad e impuestos, explicados en palabras claras
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-tinta-200">
        Lo que un empresario panameño necesita saber sobre sus obligaciones, sin
        jerga y sin letra pequeña.
      </p>
    </div>
  </section>

  <section class="py-16 lg:py-20">
    <div class="mx-auto max-w-6xl px-5">
      <!-- El más reciente, a lo ancho -->
      <a href={`/blog/${destacado.slug}/`} class="tarjeta block rounded-2xl border border-tinta-200 bg-white p-8 lg:p-11">
        <p class="text-xs font-bold tracking-widest text-acento-500 uppercase">Lo último</p>
        <h2 class="mt-3 max-w-3xl font-titulo text-2xl leading-tight font-black tracking-tight lg:text-3xl">
          {destacado.h1}
        </h2>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-tinta-700">{destacado.entradilla}</p>
        <p class="mt-5 text-sm text-tinta-500">
          {fmt(destacado.fecha)} · {destacado.minutos} min de lectura
        </p>
      </a>

      <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          resto.map((a) => (
            <a href={`/blog/${a.slug}/`} class="tarjeta flex flex-col rounded-xl border border-tinta-200 bg-white p-7">
              <h2 class="font-titulo text-xl leading-snug font-bold">{a.h1}</h2>
              <p class="mt-3 grow leading-relaxed text-tinta-700">{a.entradilla}</p>
              <p class="mt-5 text-sm text-tinta-500">{fmt(a.fecha)} · {a.minutos} min</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-tinta-900 py-16">
    <div class="mx-auto max-w-3xl px-5 text-center">
      <h2 class="font-titulo text-2xl font-black tracking-tight text-white lg:text-3xl">
        ¿Su caso no está en ningún artículo?
      </h2>
      <p class="mt-3 text-tinta-200">Pregúntenos directamente. La primera consulta es gratuita. {SITE.horario}.</p>
      <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={`tel:${SITE.telefonoE164}`} class="rounded-md bg-acento-500 px-6 py-3.5 font-titulo font-bold text-white hover:bg-acento-400">
          Llamar al {SITE.telefono}
        </a>
        <a href="/contacto/" class="rounded-md border border-white/25 px-6 py-3.5 font-titulo font-bold text-white hover:bg-white/10">
          Escribir un mensaje
        </a>
      </div>
    </div>
  </section>
</Base>
